# Copiar a .env.local para desarrollo con `vercel dev`.
# En producción, cargar estas mismas variables en el dashboard de Vercel
# (Project Settings → Environment Variables). Nunca commitear valores reales.

# Personal Access Token de Airtable, con scope de solo lectura (data.records:read)
# restringido a la base de Nissi Propiedades.
AIRTABLE_TOKEN=

# ID de la base de Airtable (empieza con "app...").
AIRTABLE_BASE_ID=

# Nombre exacto de la tabla que contiene las propiedades.
AIRTABLE_TABLE_NAME=
